# Turbopack ignore file
# Exclude Python virtual environments and backend code from Next.js build

# Python environments
self-serve/**
venv/
venv311/
**/__pycache__/
*.py
*.pyc
*.pyo
*.pyd
.Python

# Server code (not part of Next.js frontend)
../server/
../discvr-deploy/
../lamf-agent/
../data/

# Build artifacts
.next/
out/
build/
dist/

